{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mnapoli/blog",
    "description": "Matthieu Napoli's personal website and Markdown blog.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "bref/bref": "^3.0",
        "bref/laravel-bridge": "^3.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "league/commonmark": "^2.10",
        "mnapoli/front-yaml": "^2.0.6",
        "php-feed-io/feed-io": "^6.4",
        "symfony/yaml": "^8.0",
        "tempest/highlight": "^2.28",
        "thecodingmachine/safe": "^3.4"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "make preview"
        ],
        "lint": "pint --test",
        "test": "@php artisan test",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.5.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
